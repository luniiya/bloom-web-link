{
  "name": "@askjo/bloom-web-link",
  "version": "1.16.0",
  "description": "Headless browser automation server and OpenClaw plugin for AI agents - anti-detection, element refs, and session isolation",
  "type": "module",
  "main": "server.js",
  "license": "MIT",
  "author": "Jo Inc <oss@askjo.ai>",
  "homepage": "https://github.com/jo-inc/bloom-web-link#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jo-inc/bloom-web-link.git"
  },
  "bugs": {
    "url": "https://github.com/jo-inc/bloom-web-link/issues"
  },
  "keywords": [
    "browser",
    "automation",
    "headless",
    "scraping",
    "bwl",
    "camoufox",
    "anti-detection",
    "ai-agent",
    "openclaw",
    "clawdbot",
    "moltbot",
    "playwright",
    "firefox",
    "youtube",
    "transcript"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.2.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "files": [
    "server.js",
    "src/",
    "lib/",
    "plugins/",
    "bwl.config.json",
    "plugin.ts",
    "plugin.js",
    "dist/plugin.js",
    "tsconfig.json",
    "openclaw.plugin.json",
    "mcp/",
    "bin/",
    "scripts/",
    "run.sh",
    "Dockerfile",
    "Dockerfile.ci",
    "compose.yaml",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "!**/*.test.js",
    "!**/*.test.ts",
    "!**/*.spec.js"
  ],
  "openclaw": {
    "extensions": [
      "plugin.ts"
    ],
    "runtimeExtensions": [
      "plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.5.3"
    },
    "tools": [
      {
        "name": "bwl_create_tab",
        "description": "Open a new browser tab at a URL"
      },
      {
        "name": "bwl_snapshot",
        "description": "Get accessibility snapshot with element refs"
      },
      {
        "name": "bwl_click",
        "description": "Click by ref, CSS selector, or viewport coordinates"
      },
      {
        "name": "bwl_wait",
        "description": "Wait for page readiness, a selector, text, or URL"
      },
      {
        "name": "bwl_mouse",
        "description": "Move, hover, or drag the native browser mouse"
      },
      {
        "name": "bwl_type",
        "description": "Type text into an element"
      },
      {
        "name": "bwl_navigate",
        "description": "Navigate to URL or search macro"
      },
      {
        "name": "bwl_scroll",
        "description": "Scroll page up/down/left/right"
      },
      {
        "name": "bwl_screenshot",
        "description": "Capture page screenshot"
      },
      {
        "name": "bwl_close_tab",
        "description": "Close a browser tab"
      },
      {
        "name": "bwl_evaluate",
        "description": "Execute JavaScript in a Camoufox tab page context"
      },
      {
        "name": "bwl_list_tabs",
        "description": "List open tabs for a user"
      },
      {
        "name": "bwl_import_cookies",
        "description": "Import Netscape cookie file (requires BWL_API_KEY)"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p . || true; mkdir -p dist && cp plugin.js dist/plugin.js",
    "prepublishOnly": "npm run build",
    "start": "bun run src/index.ts",
    "start:core": "bun run server.js",
    "mcp": "node mcp/server.mjs",
    "typecheck:container": "tsc --noEmit -p tsconfig.container.json",
    "test:mcp": "npm ci --prefix mcp && node scripts/test-mcp.mjs && node scripts/test-mcp-package.mjs",
    "test:container": "bun run typecheck:container && bun run scripts/test-container.ts",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --forceExit tests/unit",
    "test": "npm run test:unit && npm run test:e2e && npm run test:plugins",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules' jest --config jest.config.e2e.cjs --runInBand --forceExit",
    "test:plugins": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit plugins/",
    "test:live": "RUN_LIVE_TESTS=1 NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --forceExit tests/live",
    "test:debug": "DEBUG_SERVER=1 NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --forceExit",
    "plugin": "node scripts/plugin.js",
    "generate-openapi": "node scripts/generate-openapi.js",
    "version:sync": "node scripts/sync-version.js",
    "version": "node scripts/sync-version.js && node scripts/generate-openapi.js && git add openclaw.plugin.json mcp/package.json mcp/package-lock.json openapi.json",
    "postinstall": "node scripts/postinstall.js",
    "fetch-bin": "npx camoufox-js fetch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "13.0.1",
    "camoufox-js": "0.11.5",
    "express": "^5.2.1",
    "playwright-core": "^1.58.0",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jest": "^30.4.2",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@jest/reporters": {
      "glob": "13.0.6"
    },
    "babel-plugin-istanbul": {
      "test-exclude": "8.0.0"
    },
    "jest-config": {
      "glob": "13.0.6"
    },
    "jest-runtime": {
      "glob": "13.0.6"
    },
    "swagger-jsdoc": {
      "glob": "13.0.6"
    },
    "qs": "6.16.0",
    "fast-uri": "3.1.7",
    "hono": "4.13.5"
  },
  "bin": {
    "bloom-web-link": "./bin/bloom-web-link.js",
    "bloom-web-link-mcp": "./mcp/server.mjs"
  }
}
