{
  "name": "@askjo/bloom-web-link-mcp",
  "version": "1.16.0",
  "description": "Standalone stdio MCP server exposing the bloom-web-link REST API as MCP tools (Claude Code, Codex, agy, Cursor, opencode). Proxies to an already-running bloom-web-link REST server — does not itself require the browser binary, Playwright, or the core server's dependencies. Initial MCP implementation contributed by @epicsagas.",
  "type": "module",
  "main": "server.mjs",
  "license": "MIT",
  "author": "Luniiya",
  "homepage": "https://github.com/luniiya/bloom-web-link/tree/main/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luniiya/bloom-web-link.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/luniiya/bloom-web-link/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bwl",
    "camoufox",
    "browser-automation",
    "claude-code",
    "codex",
    "cursor",
    "opencode"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "bin": {
    "bloom-web-link-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "lib/",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "hono": "4.13.5",
    "qs": "6.16.0"
  }
}
