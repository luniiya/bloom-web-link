# Authentication is OFF by default for loopback-only local use.
# Uncomment and set this before exposing Camofox through a reverse proxy or LAN bind.
# CAMOFOX_ACCESS_KEY=replace-with-a-long-random-secret

# Cookie import and administrative shutdown have separate optional keys.
# CAMOFOX_API_KEY=replace-with-a-long-random-secret
# CAMOFOX_ADMIN_KEY=replace-with-a-long-random-secret

CAMOFOX_CRASH_REPORT_ENABLED=false
